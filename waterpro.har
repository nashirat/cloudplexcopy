            "mimeType": "text/html; charset=utf-8",
            "size": 10550,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Three.js Water Pro - Demo</title>\n  <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n  <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n  <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n  <link rel=\"manifest\" href=\"/site.webmanifest\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500&display=swap\" rel=\"stylesheet\">\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      width: 100vw;\n      height: 100vh;\n      overflow: hidden;\n      font-family: system-ui, -apple-system, sans-serif;\n      background: #000;\n    }\n\n    canvas {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    #performance {\n      display: none;\n      position: absolute;\n      z-index: 10;\n      top: 10px;\n      left: 10px;\n      color: white;\n      background: rgba(0, 0, 0, 0.7);\n      padding: 12px 16px;\n      border-radius: 6px;\n      font-size: 12px;\n      font-family: 'Monaco', 'Menlo', 'Consolas', monospace;\n      pointer-events: none;\n      min-width: 180px;\n    }\n\n    #performance .title {\n      font-weight: bold;\n      font-size: 14px;\n      margin-bottom: 10px;\n      padding-bottom: 8px;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.2);\n    }\n\n    #performance .title .version {\n      font-weight: normal;\n      font-size: 11px;\n      color: rgba(255, 255, 255, 0.5);\n      margin-left: 6px;\n    }\n\n    #performance .row {\n      display: flex;\n      justify-content: space-between;\n      margin: 4px 0;\n    }\n\n    #performance .label {\n      color: rgba(255, 255, 255, 0.7);\n    }\n\n    #performance .value {\n      color: #4fc3f7;\n      font-weight: bold;\n    }\n\n    #performance .value.good {\n      color: #81c784;\n    }\n\n    #performance .value.warn {\n      color: #ffb74d;\n    }\n\n    #performance .value.bad {\n      color: #e57373;\n    }\n\n    #performance .fps-large {\n      font-size: 32px;\n      font-weight: bold;\n      color: #4fc3f7;\n      text-align: center;\n      margin-bottom: 8px;\n      padding-bottom: 8px;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.2);\n    }\n\n    #performance .fps-large .fps-label {\n      font-size: 11px;\n      color: rgba(255, 255, 255, 0.5);\n      font-weight: normal;\n      display: block;\n      margin-bottom: 2px;\n    }\n\n    #performance .value.webgpu {\n      color: #81c784;\n    }\n\n    #performance .value.webgl {\n      color: #ffb74d;\n    }\n\n    #purchase-link {\n      position: fixed;\n      bottom: 16px;\n      right: 16px;\n      z-index: 999;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 10px 18px;\n      background: rgba(26, 26, 26, 0.9);\n      border: 1px solid rgba(74, 158, 255, 0.4);\n      border-radius: 6px;\n      color: #4facfe;\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 13px;\n      font-weight: 500;\n      text-decoration: none;\n      letter-spacing: 0.5px;\n      backdrop-filter: blur(8px);\n      -webkit-backdrop-filter: blur(8px);\n      transition: background 0.2s, border-color 0.2s;\n    }\n\n    #purchase-link:hover {\n      background: rgba(40, 40, 40, 0.95);\n      border-color: rgba(74, 158, 255, 0.7);\n    }\n\n    @media (max-width: 768px) {\n      #purchase-link {\n        bottom: auto;\n        top: 48px;\n        right: 8px;\n        padding: 8px 14px;\n        font-size: 12px;\n      }\n    }\n\n    #loading-overlay {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background: #000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 9999;\n      opacity: 0;\n      visibility: hidden;\n      transition: opacity 0.15s ease-out, visibility 0.15s ease-out;\n    }\n\n    #loading-overlay.visible {\n      opacity: 1;\n      visibility: visible;\n    }\n\n    #loading-overlay .loading-text {\n      color: rgba(255, 255, 255, 0.8);\n      font-size: 18px;\n      font-family: 'Monaco', 'Menlo', 'Consolas', monospace;\n      letter-spacing: 1px;\n    }\n\n    /* ── Initial loading screen ── */\n    #initial-loading {\n      position: fixed;\n      inset: 0;\n      background: #030a12;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      z-index: 10000;\n      transition: opacity 0.8s ease-out, visibility 0.8s ease-out;\n    }\n\n    #initial-loading.hidden {\n      opacity: 0;\n      visibility: hidden;\n    }\n\n    #initial-loading .logo-title {\n      font-family: 'Montserrat', system-ui, -apple-system, sans-serif;\n      font-size: 28px;\n      font-weight: 300;\n      letter-spacing: 6px;\n      text-transform: uppercase;\n      color: rgba(255, 255, 255, 0.9);\n      margin-bottom: 48px;\n      text-align: center;\n    }\n\n    #initial-loading .logo-title span {\n      color: #4facfe;\n      font-weight: 500;\n    }\n\n    .wave-bars {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      height: 32px;\n    }\n\n    .wave-bars .bar {\n      width: 3px;\n      height: 8px;\n      border-radius: 2px;\n      background: #4facfe;\n      animation: wave-bar 1.2s ease-in-out infinite;\n    }\n\n    .wave-bars .bar:nth-child(1) {\n      animation-delay: 0s;\n    }\n\n    .wave-bars .bar:nth-child(2) {\n      animation-delay: 0.1s;\n    }\n\n    .wave-bars .bar:nth-child(3) {\n      animation-delay: 0.2s;\n    }\n\n    .wave-bars .bar:nth-child(4) {\n      animation-delay: 0.3s;\n    }\n\n    .wave-bars .bar:nth-child(5) {\n      animation-delay: 0.4s;\n    }\n\n    .wave-bars .bar:nth-child(6) {\n      animation-delay: 0.5s;\n    }\n\n    .wave-bars .bar:nth-child(7) {\n      animation-delay: 0.6s;\n    }\n\n    .wave-bars .bar:nth-child(8) {\n      animation-delay: 0.7s;\n    }\n\n    .wave-bars .bar:nth-child(9) {\n      animation-delay: 0.8s;\n    }\n\n    .wave-bars .bar:nth-child(10) {\n      animation-delay: 0.9s;\n    }\n\n    @keyframes wave-bar {\n\n      0%,\n      100% {\n        height: 8px;\n        opacity: 0.4;\n      }\n\n      50% {\n        height: 28px;\n        opacity: 1;\n      }\n    }\n\n    #initial-loading .loading-status {\n      margin-top: 32px;\n      font-family: 'Monaco', 'Menlo', 'Consolas', monospace;\n      font-size: 12px;\n      color: rgba(255, 255, 255, 0.35);\n      letter-spacing: 2px;\n      text-transform: uppercase;\n    }\n\n    /* ── Mobile: loading screen ── */\n    @media (max-width: 480px) {\n      #initial-loading .logo-title {\n        font-size: 18px;\n        letter-spacing: 4px;\n        margin-bottom: 36px;\n      }\n\n      .wave-bars {\n        gap: 3px;\n        height: 24px;\n      }\n\n      .wave-bars .bar {\n        width: 2.5px;\n        height: 6px;\n      }\n\n      @keyframes wave-bar {\n\n        0%,\n        100% {\n          height: 6px;\n          opacity: 0.4;\n        }\n\n        50% {\n          height: 20px;\n          opacity: 1;\n        }\n      }\n\n      #initial-loading .loading-status {\n        margin-top: 24px;\n        font-size: 10px;\n      }\n    }\n\n    /* ── Mobile: compact performance bar ── */\n    @media (max-width: 768px) {\n      #performance {\n        top: 0 !important;\n        left: 0 !important;\n        right: 0;\n        width: 100%;\n        min-width: unset;\n        border-radius: 0;\n        padding: 6px 12px;\n        display: flex !important;\n        flex-direction: row;\n        align-items: center;\n        gap: 12px;\n        font-size: 11px;\n        background: rgba(0, 0, 0, 0.85);\n      }\n\n      #performance .fps-large {\n        font-size: 14px;\n        margin-bottom: 0;\n        padding-bottom: 0;\n        border-bottom: none;\n        display: flex;\n        align-items: baseline;\n        gap: 3px;\n      }\n\n      #performance .fps-large .fps-label {\n        font-size: 9px;\n        display: inline;\n        margin-bottom: 0;\n      }\n\n      #performance .row {\n        margin: 0;\n        gap: 4px;\n      }\n\n      #performance .label {\n        font-size: 0;\n        line-height: 1;\n      }\n\n      #performance .label::before {\n        font-size: 13px;\n      }\n\n      #performance .label-frame-time::before {\n        content: \"\\23F1\\FE0E\";\n      }\n\n      #performance .label-draw-calls::before {\n        content: \"\\270E\";\n      }\n\n      #performance .label-triangles::before {\n        content: \"\\25B3\";\n      }\n\n      #performance .label-pixel-ratio::before {\n        content: \"\\25A3\";\n      }\n\n      #performance .row-renderer {\n        margin-left: auto;\n      }\n\n      #performance .row-renderer .label {\n        display: none;\n      }\n\n      #performance .value {\n        font-size: 11px;\n      }\n    }\n  </style>\n  <script type=\"module\" crossorigin src=\"/assets/main-BFhFKOiM.js\"></script>\n</head>\n\n<body>\n  <div id=\"performance\">\n    <div class=\"fps-large\">\n      <span class=\"fps-label\">FPS</span>\n      <span id=\"fps\">--</span>\n    </div>\n    <div class=\"row\">\n      <span class=\"label label-frame-time\">Frame Time</span>\n      <span class=\"value\" id=\"frame-time\">--</span>\n    </div>\n    <div class=\"row\">\n      <span class=\"label label-draw-calls\">Draw Calls</span>\n      <span class=\"value\" id=\"draw-calls\">--</span>\n    </div>\n    <div class=\"row\">\n      <span class=\"label label-triangles\">Triangles</span>\n      <span class=\"value\" id=\"triangles\">--</span>\n    </div>\n    <div class=\"row row-renderer\">\n      <span class=\"label label-renderer\">Renderer</span>\n      <span class=\"value\" id=\"renderer\">--</span>\n    </div>\n    <div class=\"row\">\n      <span class=\"label label-pixel-ratio\">Pixel Ratio</span>\n      <span class=\"value\" id=\"pixel-ratio\">--</span>\n    </div>\n  </div>\n  <a id=\"purchase-link\" href=\"https://threejsroadmap.com/buy-threejs-water-pro\" target=\"_blank\" rel=\"noopener\"> 💧 Get\n    Three.js Water Pro</a>\n  <div id=\"loading-overlay\">\n    <span class=\"loading-text\">Rebuilding Shaders...</span>\n  </div>\n  <div id=\"initial-loading\">\n    <div class=\"logo-title\">Three.js <span>Water</span> Pro Demo</div>\n    <div class=\"wave-bars\">\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n      <div class=\"bar\"></div>\n    </div>\n    <div class=\"loading-status\">Loading</div>\n  </div>\n</body>\n\n</html>"
